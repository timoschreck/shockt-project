    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 60.84,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 18,
    "text": "Jede Zeit nimmt ihren Schnitt,",
    "matched_word_fraction": 0.8,
    "candidate_start_seconds": 62.9,
    "status": "unverified_reference_alignment"
  },
  {
