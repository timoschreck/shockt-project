  {
    "reference_line": 15,
    "text": "entweder Gewinner oder nichts.",
    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 56.8,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 16,
    "text": "Doch wenn das Licht im Viertel bricht,",
    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 58.76,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 17,
