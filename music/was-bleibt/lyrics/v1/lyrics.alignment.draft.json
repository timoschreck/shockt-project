    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 5,
    "text": "Was bleibt?",
    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 14.06,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 6,
    "text": "Mit sechzehn war’n wir Könige im Block vor der Tür,",
