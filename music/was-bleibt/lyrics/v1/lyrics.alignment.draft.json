    "candidate_start_seconds": 68.52,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 22,
    "text": "Was bleibt, was bleibt,",
    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 71.02,
    "status": "unverified_reference_alignment"
  },
