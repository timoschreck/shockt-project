    "matched_word_fraction": 0.833,
    "candidate_start_seconds": 64.92,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 20,
    "text": "Wenn die ganze Fassade fällt,",
    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 66.64,
    "status": "unverified_reference_alignment"
  },
