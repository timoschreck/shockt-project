    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 119.58,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 39,
    "text": "Ich hab gelacht und gesagt: „Keine Sorge, ich weiß.“",
