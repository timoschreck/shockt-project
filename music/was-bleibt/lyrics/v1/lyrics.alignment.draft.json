    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 47.7,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 12,
    "text": "Wir hielten Likes für Respekt, falsche Brüder für echt,",
    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 49.98,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 13,
    "text": "heute weiß ich: Große Worte machen keinen zum Chef.",
    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 52.3,
    "status": "unverified_reference_alignment"
  },
  {
    "reference_line": 14,
    "text": "Jeder Blick war wie Gericht,",
    "matched_word_fraction": 1.0,
    "candidate_start_seconds": 54.42,
    "status": "unverified_reference_alignment"
